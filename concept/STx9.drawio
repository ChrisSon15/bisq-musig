        <mxCell id="76" parent="75" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Output 0:&lt;/font&gt;&lt;/b&gt; agreed on&amp;nbsp;amount for Bob" vertex="1">
          <mxGeometry height="30" width="320" y="30" as="geometry" />
